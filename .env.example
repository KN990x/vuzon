# vuzon — self-hosted panel for Cloudflare Email Routing
#
# Fill in the two values below and start the panel. Open it in a browser and it will ask
# you to choose your username and password — there is nothing else to set up.
# (The server refuses to start while either value is empty.)
#
# Every optional variable is documented in README.md.

# Your email domain in Cloudflare — e.g. mydomain.dev
DOMAIN=

# Cloudflare API token with exactly these three scopes:
#   Zone    → Email Routing Rules:     Edit
#   Account → Email Routing Addresses: Edit
#   Zone    → Zone:                    Read
CF_API_TOKEN=


# ---------------------------------------------------------------------------------------
# Optional — the defaults suit a homelab on plain HTTP. You can ignore all of it.
# ---------------------------------------------------------------------------------------

# Host port the panel is published on (default 8001).
# VUZON_PORT=8001

# Behind HTTPS or a TLS-terminating proxy: marks the session cookie Secure.
# COOKIE_SECURE=1

# Behind a reverse proxy: lets the real client IP reach the login rate limit.
# Accepted values in README.md.
# TRUST_PROXY=1
