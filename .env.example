# vuzon — self-hosted panel for Cloudflare Email Routing
#
# Fill in the two values below, start the panel, and choose username/password in the browser.
# (The server refuses to start while either value is empty.)
# Optional variables are documented in README.md.

# Your email domain in Cloudflare — e.g. mydomain.dev
DOMAIN=

# Cloudflare API token with exactly these three scopes:
#   Zone    → Email Routing Rules:     Edit
#   Account → Email Routing Addresses: Edit
#   Zone    → Zone:                    Read
CF_API_TOKEN=


# ---------------------------------------------------------------------------------------
# Optional — defaults suit a homelab on plain HTTP.
# ---------------------------------------------------------------------------------------

# Host port (default 8001).
# VUZON_PORT=8001

# Behind HTTPS / TLS-terminating proxy: Secure session cookie.
# COOKIE_SECURE=1

# Behind a reverse proxy only. Leave OFF if clients can reach the panel directly
# (spoofable X-Forwarded-For bypasses login rate limits). Pair with COOKIE_SECURE=1.
# TRUST_PROXY=1
